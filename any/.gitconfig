[include]
  path = ~/.config/git/user
  path = ~/.config/git/aliases
  path = ~/.config/git/core
  path = ~/.config/git/default_branch
  path = ~/.config/git/signing
[protocol]
	version = 2
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
